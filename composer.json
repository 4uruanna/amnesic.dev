{
    "name": "apimail/apimail",
    "description": "API de réception et de lecture de mails",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "php-di/php-di": "^7",
        "slim/psr7": "^1.8",
        "slim/slim": "^4"
    },
    "autoload": {
        "psr-4": {
            "Apimail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apimail\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
