{
    "name": "apimail/robot",
    "description": "Robot du Relais : relève Mailpit et dépose chaque mail dans l'API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "Robot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Robot\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
